[gd_resource type="Resource" script_class="ParamPanelScene" load_steps=16 format=3]

; MVP-C.1 示范场景 1：玩家方视觉（跨 3 Resource 聚合，B 方案核心价值）
; 设计原文：tile-advanture-design/参数Resource化/MVP-C_运行时调参面板.md §5.B 示范 1

[ext_resource type="Script" path="res://scripts/config/param_panel_scene.gd" id="1_scene"]
[ext_resource type="Script" path="res://scripts/config/param_field_mapping.gd" id="2_field"]

[sub_resource type="Resource" id="F_faction_color"]
script = ExtResource("2_field")
display_label = "★身份色（核心）"
group_name = "身份色"
target_resource_path = "res://assets/config/influence_config.tres"
field_name = "faction_colors"
dict_key = 1
control_type = "ColorEdit3"
slider_min = 0.0
slider_max = 1.0
redraw_targets_override = []
passive = false
tooltip = "PLAYER 阵营色（Dict key=1）"

