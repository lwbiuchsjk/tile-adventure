[resource]
script = ExtResource("1_scene")
scene_id = "player_visual"
display_name = "玩家方视觉"
category = "身份与势力"
default_redraw_targets = Array[String](["WorldMapRenderer"])
fields = Array[Resource]([SubResource("F_faction_color"), SubResource("F_unit_ring_width"), SubResource("F_unit_color"), SubResource("F_unit_shadow"), SubResource("F_unit_margin"), SubResource("F_alpha_outer"), SubResource("F_alpha_mid"), SubResource("F_alpha_inner"), SubResource("F_persist_ring_width"), SubResource("F_persist_sep_color"), SubResource("F_persist_sep_width"), SubResource("F_persist_inner_bg"), SubResource("F_move_step_duration")])
