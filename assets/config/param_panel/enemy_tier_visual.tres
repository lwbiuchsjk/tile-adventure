[gd_resource type="Resource" script_class="ParamPanelScene" load_steps=15 format=3]

; MVP-C.1 示范场景 2：敌方层级 Tier 4 档视觉（单 Resource + Dict 字段平铺模式）
; 设计原文：tile-advanture-design/参数Resource化/MVP-C_运行时调参面板.md §5.B 示范 2

[ext_resource type="Script" path="res://scripts/config/param_panel_scene.gd" id="1_scene"]
[ext_resource type="Script" path="res://scripts/config/param_field_mapping.gd" id="2_field"]

[sub_resource type="Resource" id="F_enemy_slot_color"]
script = ExtResource("2_field")
display_label = "敌方 slot 底色"
group_name = "共享字段"
target_resource_path = "res://assets/config/unit_enemy_config.tres"
field_name = "enemy_slot_color"
dict_key = null
control_type = "ColorEdit3"
slider_min = 0.0
slider_max = 1.0
redraw_targets_override = []
passive = false
tooltip = ""

