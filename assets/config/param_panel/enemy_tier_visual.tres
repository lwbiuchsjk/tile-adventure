[resource]
script = ExtResource("1_scene")
scene_id = "enemy_tier_visual"
display_name = "敌方层级 Tier 4 档视觉"
category = "敌方表达"
default_redraw_targets = Array[String](["WorldMapRenderer"])
fields = Array[Resource]([SubResource("F_enemy_slot_color"), SubResource("F_tier_border_color"), SubResource("F_tier_dot_color"), SubResource("F_tier_dot_size_ratio"), SubResource("F_tier_1_border_width"), SubResource("F_tier_1_margin"), SubResource("F_tier_2_border_width"), SubResource("F_tier_2_margin"), SubResource("F_tier_3_border_width"), SubResource("F_tier_3_margin"), SubResource("F_tier_4_border_width"), SubResource("F_tier_4_margin")])
