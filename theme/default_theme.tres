[resource]
default_font = ExtResource("1")
default_font_size = 16

PanelContainer/styles/panel = SubResource("panel_bg")

Button/styles/normal = SubResource("btn_normal")
Button/styles/hover = SubResource("btn_hover")
Button/styles/pressed = SubResource("btn_pressed")
Button/styles/disabled = SubResource("btn_disabled")
Button/styles/focus = SubResource("btn_focus")
Button/font_sizes/font_size = 15
Button/colors/font_color = Color(0.85, 0.82, 0.75, 1.0)
Button/colors/font_hover_color = Color(1.0, 0.92, 0.70, 1.0)
Button/colors/font_pressed_color = Color(0.70, 0.65, 0.55, 1.0)
Button/colors/font_disabled_color = Color(0.45, 0.45, 0.45, 1.0)

Label/styles/normal = SubResource("label_normal")
Label/colors/font_color = Color(0.88, 0.86, 0.82, 1.0)
Label/colors/font_outline_color = Color(0, 0, 0, 0.6)
Label/constants/outline_size = 1
Label/font_sizes/font_size = 15

; MVP-α.5：Label 变体 —— UI 标题（VictoryUI 胜利/失败大字、面板标题等）
Title/base_type = &"Label"
Title/font_sizes/font_size = 24
Title/colors/font_color = Color(1.0, 0.92, 0.70, 1.0)

; MVP-α.5：Label 变体 —— UI 副标题
Subtitle/base_type = &"Label"
Subtitle/font_sizes/font_size = 18
Subtitle/colors/font_color = Color(0.85, 0.82, 0.75, 1.0)

; MVP-α.5：VSeparator / HSeparator 默认 —— 6 UI 内分组分隔
VSeparator/styles/separator = SubResource("sep_line")
VSeparator/constants/separation = 12
HSeparator/styles/separator = SubResource("sep_line")
HSeparator/constants/separation = 12
